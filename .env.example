# ===== Copy this file to ".env" (project ROOT) and fill in your values. NEVER commit .env =====

# Database
MONGODB_URI=
JWT_SECRET=

# Server
PORT=5000
NODE_ENV=development

# AI Mentor (Google Gemini) - key stays on the server only
GEMINI_API_KEY=
# Primary model. Check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: comma-separated models to try if the primary returns 404
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash

# Code execution (Judge0) - pick ONE option
# Option A: your own self-hosted Judge0 server (recommended, no daily limits)
# JUDGE0_URL=http://YOUR_SERVER_IP:2358
# JUDGE0_AUTH_TOKEN=same_token_you_set_as_AUTHN_TOKEN_in_judge0.conf
# Option B: RapidAPI hosted Judge0 (free plan is only ~50 submissions/day per key)
JUDGE0_API_KEY_1=
JUDGE0_API_KEY_2=

# Google sign-in (optional for now - server runs fine without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (image uploads: Store product images, Documents). Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: extra allowed frontend origins, comma-separated
# CLIENT_URLS=https://my-site.netlify.app

# NOTE: VITE_GEMINI_API_KEY is no longer needed. Do NOT add it - anything starting
# with VITE_ gets bundled into the browser and becomes public.
